NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin only. No path. Code appends /auth/confirm.
# Also used for sitemap.xml, robots.txt, and Open Graph URLs.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth mail via Resend SMTP. Used by `pnpm mail:apply`.
# Reminder mail uses the same key via the Resend HTTP API (`pnpm remind`).
# Never commit real values. MAIL_FROM must be a Resend-verified domain.
# RESEND_API_KEY=
# MAIL_FROM=noreply@your-verified-domain.com
# MAIL_FROM_NAME=100 a Day
# SUPABASE_ACCESS_TOKEN=
# CRON_SECRET=
